{
  "name": "watchlistr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "workspaces": [
    "webapp"
  ],
  "scripts": {
    "start": "set -a; [ -f .env ] && . ./.env; set +a; go -C backend run .",
    "dev": "npm --workspace webapp run dev",
    "dev:all": "concurrently \"npm start\" \"npm run dev\"",
    "build": "npm --workspace webapp run build",
    "lint": "npm --workspace webapp run lint",
    "preview": "npm --workspace webapp run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
